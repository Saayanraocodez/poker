{
"leaves124": "<table class='t'><tr><th>terminal history</th><th>reach factor</th><th>payoff (P1, P2, P3)</th></tr><tr><td><code>KKK</code></td><td>\\((1-a_{11})\\,(1-b_{21})\\,(1-c_{41})\\)</td><td>\\((-1,-1,2)\\)</td></tr><tr><td><code>KKBFF</code></td><td>\\((1-a_{11})\\,(1-b_{21})\\,c_{41}\\,(1-a_{12})\\,(1-b_{23})\\)</td><td>\\((-1,-1,2)\\)</td></tr><tr><td><code>KKBFC</code></td><td>\\((1-a_{11})\\,(1-b_{21})\\,c_{41}\\,(1-a_{12})\\,b_{23}\\)</td><td>\\((-1,-2,3)\\)</td></tr><tr><td><code>KKBCF</code></td><td>\\((1-a_{11})\\,(1-b_{21})\\,c_{41}\\,a_{12}\\,(1-b_{24})\\)</td><td>\\((-2,-1,3)\\)</td></tr><tr><td><code>KKBCC</code></td><td>\\((1-a_{11})\\,(1-b_{21})\\,c_{41}\\,a_{12}\\,b_{24}\\)</td><td>\\((-2,-2,4)\\)</td></tr><tr><td><code>KBFF</code></td><td>\\((1-a_{11})\\,b_{21}\\,(1-c_{42})\\,(1-a_{13})\\)</td><td>\\((-1,2,-1)\\)</td></tr><tr><td><code>KBFC</code></td><td>\\((1-a_{11})\\,b_{21}\\,(1-c_{42})\\,a_{13}\\)</td><td>\\((-2,3,-1)\\)</td></tr><tr><td><code>KBCF</code></td><td>\\((1-a_{11})\\,b_{21}\\,c_{42}\\,(1-a_{14})\\)</td><td>\\((-1,-2,3)\\)</td></tr><tr><td><code>KBCC</code></td><td>\\((1-a_{11})\\,b_{21}\\,c_{42}\\,a_{14}\\)</td><td>\\((-2,-2,4)\\)</td></tr><tr><td><code>BFF</code></td><td>\\(a_{11}\\,(1-b_{22})\\,(1-c_{43})\\)</td><td>\\((2,-1,-1)\\)</td></tr><tr><td><code>BFC</code></td><td>\\(a_{11}\\,(1-b_{22})\\,c_{43}\\)</td><td>\\((-2,-1,3)\\)</td></tr><tr><td><code>BCF</code></td><td>\\(a_{11}\\,b_{22}\\,(1-c_{44})\\)</td><td>\\((-2,3,-1)\\)</td></tr><tr><td><code>BCC</code></td><td>\\(a_{11}\\,b_{22}\\,c_{44}\\)</td><td>\\((-2,-2,4)\\)</td></tr></table>",
"dc33_table": "<table class='t'><tr><th>deal (P1,P2,P3)</th><th>others' reach to the node</th><th>P3 calls</th><th>P3 folds</th><th>difference</th></tr><tr><td>(1, 2, 3)</td><td>\\(a_{11} \\left(1 - b_{22}\\right)\\)</td><td>\\(+3\\)</td><td>\\(-1\\)</td><td>\\(+4\\)</td></tr><tr><td>(1, 4, 3)</td><td>\\(a_{11} \\left(1 - b_{42}\\right)\\)</td><td>\\(+3\\)</td><td>\\(-1\\)</td><td>\\(+4\\)</td></tr><tr><td>(2, 1, 3)</td><td>\\(a_{21} \\left(1 - b_{12}\\right)\\)</td><td>\\(+3\\)</td><td>\\(-1\\)</td><td>\\(+4\\)</td></tr><tr><td>(2, 4, 3)</td><td>\\(a_{21} \\left(1 - b_{42}\\right)\\)</td><td>\\(+3\\)</td><td>\\(-1\\)</td><td>\\(+4\\)</td></tr><tr><td>(4, 1, 3)</td><td>\\(a_{41} \\left(1 - b_{12}\\right)\\)</td><td>\\(-2\\)</td><td>\\(-1\\)</td><td>\\(-1\\)</td></tr><tr><td>(4, 2, 3)</td><td>\\(a_{41} \\left(1 - b_{22}\\right)\\)</td><td>\\(-2\\)</td><td>\\(-1\\)</td><td>\\(-1\\)</td></tr></table>",
"dc33_formula": "\\[\\begin{aligned}D_{c_{33}}=\\tfrac1{24}\\Big[&4a_{11}\\big((1-b_{22})+(1-b_{42})\\big)+4a_{21}\\big((1-b_{12})+(1-b_{42})\\big)\\&-a_{41}\\big((1-b_{12})+(1-b_{22})\\big)\\Big]\\end{aligned}\\]",
